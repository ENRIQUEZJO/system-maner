@model List<Notificacion>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 mb-0">Notificaciones</h2>
    @if (Model.Any(n => !n.Leida))
    {
        <form asp-action="MarcarTodas" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Marcar todas como leídas</button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No tienes notificaciones.</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <a asp-action="Abrir" asp-route-id="@n.Id"
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(n.Leida ? "" : "fw-bold")">
                <span>
                    @if (!n.Leida)
                    {
                        <span class="badge bg-primary me-2">Nueva</span>
                    }
                    @n.Mensaje
                </span>
                <small class="text-muted text-nowrap ms-3">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
            </a>
        }
    </div>
}